{
  "name": "iptv-hub",
  "version": "2.1.0",
  "description": "A virtual Xtream Codes server that merges several IPTV providers into one catalogue without duplicates, and answers every stream with a 302 redirect so video never passes through it",
  "keywords": [
    "iptv",
    "xtream",
    "xtream-codes",
    "m3u",
    "tivimate",
    "iptv-smarters",
    "playlist",
    "self-hosted",
    "failover",
    "sqlite"
  ],
  "homepage": "https://github.com/mohamad-aljeiawi/iptv-hub#readme",
  "bugs": {
    "url": "https://github.com/mohamad-aljeiawi/iptv-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamad-aljeiawi/iptv-hub.git"
  },
  "license": "MIT",
  "author": "Mohamad Aljeiawi",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.16" },
  "main": "src/index.js",
  "scripts": {
    "start": "node --no-warnings src/index.js",
    "dev": "node --no-warnings scripts/dev.js",
    "mocks": "node --no-warnings test/mock-xtream.js",
    "test": "node --no-warnings --test test/*.test.js"
  }
}
