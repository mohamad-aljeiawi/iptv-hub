# Reference for every setting. install.sh generates a real .env, which is never
# committed to git.
# For local development: cp .env.example .env

# Listening port. On a server install.sh picks one automatically from
# 18000-18999 and it never changes afterwards.
PORT=8080

# Listening address. Always keep this at 127.0.0.1 on a public server: the app
# runs behind a proxy and must not be exposed to the internet directly.
HOST=127.0.0.1

# Admin password. Leave empty to have one generated once and stored in the
# database. To show or change it later: iptvhub admin-pass
ADMIN_TOKEN=

# Public URL used to build player links and the M3U playlist.
# Leave empty to derive it from the proxy headers (Host and X-Forwarded-Proto).
PUBLIC_URL=

# Database path. On a server this lives outside the code directory so that no
# update can touch it.
DB=./catalog.db

# How often, in hours, each server's catalogue is re-fetched.
SYNC_HOURS=6

# How often, in minutes, upstream servers are health-checked (drives failover).
HEALTH_MIN=5

# User-Agent sent to the upstream servers.
UA=Mozilla/5.0

# In-browser playback. The web player streams through this server with ffmpeg
# (players like TiviMate still get a direct redirect and use no bandwidth here).
# Browser streams at once; further viewers get the external-player buttons.
PLAY_MAX_VIEWERS=5
# Full video re-encodes (HEVC and other codecs browsers cannot play) at once.
PLAY_MAX_TRANSCODES=3
# Height cap for re-encoded video.
PLAY_MAX_HEIGHT=720
