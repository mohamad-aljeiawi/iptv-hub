[Unit]
Description=IPTV Hub — virtual Xtream server
Documentation=https://github.com/mohamad-aljeiawi/iptv-hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__NODE__ --no-warnings __APP_DIR__/src/index.js
Restart=always
RestartSec=3

# Resource limits
MemoryMax=__MEMORY_MAX__
TasksMax=256

# Hardening: the service gets no more than it needs
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Node needs AF_UNIX and AF_NETLINK for name resolution; without them every
# upstream request fails.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

# The only writable path is the data directory
ReadWritePaths=__DATA_DIR__

StandardOutput=journal
StandardError=journal
SyslogIdentifier=iptv-hub

[Install]
WantedBy=multi-user.target
